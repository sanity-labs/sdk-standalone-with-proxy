# Copy to .env for local development. `sanity dev` reads it for the app, and
# `pnpm dev:oauth` (`vercel dev`) loads `.env` (not `.env.local`) for the
# functions in api/. `.env` is gitignored.
# On Vercel, set these in Project Settings > Environment Variables.

# --- Shared: build-time for the browser, runtime for the auth functions ---
# `sanity build` inlines every SANITY_APP_* value into the browser bundle.
# Put identifiers here, never tokens.

# Required.
SANITY_APP_PROJECT_ID=
SANITY_APP_DATASET=production

# Required. ID of the organization that owns the project (sanity.io/manage, or
# `sanity organizations list`). Used by `sanity dev` and by the OAuth functions,
# which scope tokens to this organization.
SANITY_APP_ORGANIZATION_ID=

# How users sign in: `project` (default, project-scoped login, no server code)
# or `oauth` (Sanity OAuth via api/auth/sanity/*, needs the server-only variables
# below). Read by the browser build and, at runtime, by the auth functions, which
# answer 404 unless this is `oauth`.
SANITY_APP_AUTH_MODE=project

# Optional, `project` mode: SAML SSO. The project-specific login URL from
# sanity.io/manage -> Organization -> Settings -> SAML SSO (not a secret), the
# button text, and whether to hide the other login options. See README step 7P.
SANITY_APP_SSO_LOGIN_URL=
SANITY_APP_SSO_TITLE=
SANITY_APP_SSO_ONLY=

# Optional: limit the example document list to one _type.
SANITY_APP_DOCUMENT_TYPE=

# Optional: set to `true` on deployments that include api/sanity-proxy.ts.
# Routes global api.sanity.io calls through the same-origin /sanity-api proxy.
SANITY_APP_GLOBAL_API_PROXY=

# --- Server only, `oauth` mode: read by api/auth/sanity/* at runtime ---
# Never use the SANITY_APP_ prefix for these, or they could end up in the bundle.

# ID of the OAuth client registered for your Sanity organization.
SANITY_OAUTH_CLIENT_ID=
# OAuth client secret. Shown once when the client is created. Keep it out of code, tickets and chat.
SANITY_OAUTH_CLIENT_SECRET=
# Encrypts the session and OAuth transaction cookies.
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
SANITY_OAUTH_AUTHORIZE_URL=https://api.sanity.io/v1/auth/oauth/authorize
SANITY_OAUTH_TOKEN_URL=https://api.sanity.io/v1/auth/oauth/token
SANITY_OAUTH_REVOKE_URL=https://api.sanity.io/v1/auth/oauth/revoke
# Must match a redirect URI registered on the OAuth client exactly.
SANITY_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/sanity/callback
# Refresh when the access token has less than this many seconds left (default 1 day).
SANITY_TOKEN_REFRESH_WINDOW_SECONDS=86400
