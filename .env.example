# Copy to .env.local for local development.
# On Vercel, pass these at build time (`vercel deploy --build-env KEY=value`) or set
# them in Project Settings > Environment Variables.
#
# `sanity build` inlines every SANITY_APP_* value into the browser bundle.
# Put identifiers here, never tokens.

# Required.
SANITY_APP_PROJECT_ID=
SANITY_APP_DATASET=production

# Required by `sanity dev` (read in sanity.cli.ts). Not needed for `sanity build`.
SANITY_APP_ORGANIZATION_ID=

# Optional: limit the example document list to one _type.
SANITY_APP_DOCUMENT_TYPE=

# Optional: set to `true` on deployments that include api/sanity-proxy.ts.
# Routes global api.sanity.io calls through the same-origin /sanity-api proxy.
SANITY_APP_GLOBAL_API_PROXY=
